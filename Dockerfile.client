# 1. Use an official Python runtime as the base image
FROM python:3.12-slim

# 2. Set the working directory inside the container
WORKDIR /app

# 3. Copy only the requirements file first to leverage Docker caching
COPY requirements.txt .

# 4. Install the specified dependencies
RUN pip install streamlit

# 5. Copy the rest of the application source code
COPY frontend/ .

# Inform Docker that the container listens on port 8501
EXPOSE 8501

# Configure Streamlit to run without opening a browser window and bind to all network interfaces
ENTRYPOINT ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0"]